{
  "name": "onetake",
  "version": "2.0.0",
  "description": "Script product demo videos: a human-like cursor, real UI interactions, hand-drawn highlights and smooth camera zoom, rendered to 60 fps in one take.",
  "main": "dist/onetake.js",
  "browser": "dist/onetake.js",
  "types": "types/onetake.d.ts",
  "exports": {
    ".": {
      "types": "./types/onetake.d.ts",
      "default": "./dist/onetake.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "onetake": "bin/onetake.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/recorder/",
    "types/",
    "templates/",
    "skills/",
    "assets/icon.svg",
    "AGENTS.md",
    "llms.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/build.js && node --test test/unit/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:compat": "node scripts/build.js && node test/e2e/compat.js",
    "test:record": "node scripts/build.js && node test/e2e/record.js",
    "test:visual": "node scripts/build.js && node test/e2e/visual.js",
    "test:all": "npm test && node test/e2e/compat.js && node test/e2e/record.js"
  },
  "keywords": [
    "demo",
    "video",
    "screen-recording",
    "cursor",
    "automation",
    "product-tour",
    "zoom",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TharinduWijayarathna/one-take.git"
  },
  "homepage": "https://github.com/TharinduWijayarathna/one-take",
  "bugs": {
    "url": "https://github.com/TharinduWijayarathna/one-take/issues"
  },
  "dependencies": {
    "playwright": "^1.56.1"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "alpinejs": "^3.17.4",
    "flowbite-datepicker": "^1.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.44"
  },
  "license": "MIT"
}
