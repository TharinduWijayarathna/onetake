{
  "name": "onetake",
  "version": "1.0.0",
  "description": "Script product demo videos: a human-like cursor, real UI interactions, hand-drawn highlights and smooth camera zoom, rendered to 60 fps in one take.",
  "main": "dist/onetake.js",
  "browser": "dist/onetake.js",
  "files": [
    "dist/",
    "tools/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/build.js && node test/smoke.js",
    "example": "node tools/record.js --url examples/demo.html --script examples/tour.js --out recordings --width 1280 --height 760",
    "record": "node tools/record.js"
  },
  "keywords": [
    "demo",
    "video",
    "screen-recording",
    "cursor",
    "automation",
    "product-tour",
    "zoom",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TharinduWijayarathna/one-take.git"
  },
  "homepage": "https://github.com/TharinduWijayarathna/one-take",
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "license": "MIT"
}
